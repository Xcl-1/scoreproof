# ===== LLM（文本：仅做条目抽取与条款定位，绝不用于算分）=====
# DeepSeek 当前文本模型：deepseek-v4-flash / deepseek-v4-pro
DEEPSEEK_API_KEY=
SCOREPROOF_LLM_BASE_URL=https://api.deepseek.com
SCOREPROOF_LLM_MODEL=deepseek-v4-flash

# ===== VLM 兜底（P2：仅低置信度奖状图片走这里）=====
SCOREPROOF_VLM_PROVIDER=          # qwen-vl-plus | glm-4v | none
DASHSCOPE_API_KEY=
ZHIPUAI_API_KEY=

# ===== 运行配置 =====
SCOREPROOF_DATA_DIR=data
SCOREPROOF_DB_PATH=data/rules/rules.sqlite
SCOREPROOF_INDEX_DB_PATH=data/index/index.sqlite
SCOREPROOF_VECTOR_DIR=data/index/chroma
SCOREPROOF_MODEL_CACHE=data/models/fastembed
SCOREPROOF_EMBEDDING_BACKEND=fastembed
SCOREPROOF_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
SCOREPROOF_RERANKER_MODEL=BAAI/bge-reranker-base
SCOREPROOF_RERANK_CANDIDATE_K=20
SCOREPROOF_RERANK_BASE_WEIGHT=4
SCOREPROOF_RERANK_MODEL_WEIGHT=1
SCOREPROOF_LOG_LEVEL=INFO
